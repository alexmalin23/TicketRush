{
  "info": {
    "name": "TicketRush API",
    "description": "High-concurrency ticket booking API.\n\n1. `docker compose up -d --build` and `npm run db:seed`\n2. Run **Auth / Login** (saves `token` for the authenticated requests)\n\nErrors always have the shape `{ statusCode, error, code, message, details?, requestId }`. Send `X-Request-Id` to choose the id that appears in the response and in the logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "providerUrl",
      "value": "http://127.0.0.1:3100"
    },
    {
      "key": "email",
      "value": "user1@test.local"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "section",
      "value": "A"
    },
    {
      "key": "seatId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "The process answers. No dependency checks.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Postgres and Redis reachable (1 s timeout each). 503 with `details` when not ready.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "201 `{ id, email, accessToken }`. Email is trimmed and lower-cased; password 8-128 chars. 409 `CONFLICT` if taken, 400 `VALIDATION_ERROR` with every invalid field.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new-user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.response.to.be.success);",
                  "const body = pm.response.json();",
                  "if (body.accessToken) {",
                  "  pm.collectionVariables.set('token', body.accessToken);",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "200 `{ id, email, accessToken }`. Saves `token` and `userId`. 401 `UNAUTHORIZED` with the same message for an unknown email and a wrong password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.response.to.be.success);",
                  "const body = pm.response.json();",
                  "if (body.accessToken) {",
                  "  pm.collectionVariables.set('token', body.accessToken);",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "200 `{ id, email }` of the token's user, read fresh from the database. 401 `UNAUTHORIZED` without a valid token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "204. Tokens are stateless: the client discards its token."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            },
            "description": "`[{ id, name, startsAt, onsaleAt, status, venue: { id, name } }]`. Public.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Event detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}"
              ]
            },
            "description": "Event plus `maxSeatsPerUser`, `waitingRoomEnabled`, `sections: [{ name, priceCents }]`. 404 `NOT_FOUND`.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Availability summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability"
              ]
            },
            "description": "`{ sections: [{ name, available, total }] }`. Expired holds count as available.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Seat map",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/seats?section={{section}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "seats"
              ],
              "query": [
                {
                  "key": "section",
                  "value": "{{section}}"
                }
              ]
            },
            "description": "`{ section, seats: [{ id, row, number, priceCents, status }] }`, status `available` or `unavailable` (never who holds it). 400 without `section`, 404 for an unknown section.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const free = pm.response.json().seats.find((s) => s.status === 'available');",
                  "if (free) pm.collectionVariables.set('seatId', free.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Holds",
      "item": [
        {
          "name": "Hold seats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "holds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [\n    {{seatId}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires login. Body `{ seatIds }` (1-6 distinct ids). All-or-nothing: either every seat is held or none. 201 `{ seats: [{ id, section, row, number, priceCents }], expiresAt }`. 409 `SEAT_UNAVAILABLE` with `details.seatIds` (the seats that could not be taken), 409 `HOLD_LIMIT_EXCEEDED` with `details { limit, owned, requested }` (held + bought seats per buyer per event), 409 `EVENT_NOT_ON_SALE`, 404 unknown event, 400 `VALIDATION_ERROR`. Repeated holds add seats and do not extend earlier ones. Seat map saves the first available seat as `seatId`."
          }
        },
        {
          "name": "My holds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/holds/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "holds",
                "me"
              ]
            },
            "description": "Requires login. 200 `{ seats: [{ id, section, row, number, priceCents, expiresAt }], expiresAt }`: the buyer's active holds, earliest expiry first. Holds are additive and never extended, so each seat has its own `expiresAt`; the top-level `expiresAt` is the next one to expire (null when nothing is held). 404 unknown event."
          }
        },
        {
          "name": "Release all my holds",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/holds/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "holds",
                "me"
              ]
            },
            "description": "Requires login. 204. Releases every seat the buyer holds in the event; the seats are available immediately. Idempotent: nothing held is still 204. Never touches other buyers' seats."
          }
        },
        {
          "name": "Release some of my holds",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/holds/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "holds",
                "me"
              ]
            },
            "description": "Requires login. Body `{ seatIds }` (1-50). 204. Releases only these seats, and only if this buyer holds them. 400 `VALIDATION_ERROR` for an empty list.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [{{seatId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "Requires login and the `Idempotency-Key` header (generated per send by the pre-request script; re-send the SAME key to replay). Body `{ eventId, seatIds }`: every seat must be held by you and not expired. 201 paid order `{ id, eventId, status, totalCents, items, createdAt }`; 402 `PAYMENT_DECLINED` (order failed, seats released); 202 payment outcome not known yet (order `pending_payment`, poll Get order); 409 `HOLD_INVALID` (`details.seatIds`), 409 `ORDER_IN_PROGRESS`, 409 `IDEMPOTENCY_IN_PROGRESS`, 422 `IDEMPOTENCY_KEY_REUSED`, 503 `PAYMENT_PROVIDER_UNAVAILABLE`, 400 missing key.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatIds\": [{{seatId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idempotencyKey')) {",
                  "  pm.collectionVariables.set('idempotencyKey', crypto.randomUUID());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('orderId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Requires login. 200 the order with its items. Someone else's order is 404."
          }
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "Requires login. 200 my orders, newest first."
          }
        }
      ]
    },
    {
      "name": "Dev",
      "item": [
        {
          "name": "Reset event",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dev/events/{{eventId}}/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dev",
                "events",
                "{{eventId}}",
                "reset"
              ]
            },
            "description": "Only with `ENABLE_DEV_ROUTES=true` (on in Docker Compose). Removes orders, payments and tickets of the event and makes every seat available. Otherwise answers like an unknown route (404).",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Mock payment provider",
      "description": "The card processor stand-in (`npm run dev:payments`, port 3100). The API calls it; these requests are for inspection and load-run cleanup.",
      "item": [
        {
          "name": "Charge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{providerUrl}}/charges",
              "host": [
                "{{providerUrl}}"
              ],
              "path": [
                "charges"
              ]
            },
            "description": "200 `{ idempotencyKey, amountCents, status: succeeded|declined, providerRef, createdAt }`. Idempotent by key: the same key returns the first charge and never charges again (422 `IDEMPOTENCY_KEY_REUSED` for a different amount). Random latency, declines and hangs per `MOCK_PAYMENT_*`; header `Mock-Outcome: succeed|decline|hang` forces one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"postman-1\",\n  \"amountCents\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Charge (forced decline)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Mock-Outcome",
                "value": "decline"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{providerUrl}}/charges",
              "host": [
                "{{providerUrl}}"
              ],
              "path": [
                "charges"
              ]
            },
            "description": "Same as Charge, with `Mock-Outcome: decline`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"postman-declined-1\",\n  \"amountCents\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ledger",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{providerUrl}}/ledger",
              "host": [
                "{{providerUrl}}"
              ],
              "path": [
                "ledger"
              ]
            },
            "description": "Every decided charge, one per idempotency key, plus totals. A double charge would show as two entries for the same order."
          }
        },
        {
          "name": "Clear ledger",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{providerUrl}}/ledger",
              "host": [
                "{{providerUrl}}"
              ],
              "path": [
                "ledger"
              ]
            },
            "description": "204. Clears the ledger between load runs."
          }
        }
      ]
    }
  ]
}
