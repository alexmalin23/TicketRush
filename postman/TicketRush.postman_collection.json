{
  "info": {
    "name": "TicketRush API",
    "description": "High-concurrency ticket booking API.\n\n1. `docker compose up -d --build` and `npm run db:seed`\n2. Run **Auth / Login** (saves `token` for the authenticated requests)\n\nErrors always have the shape `{ statusCode, error, code, message, details?, requestId }`. Send `X-Request-Id` to choose the id that appears in the response and in the logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "email",
      "value": "user1@test.local"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "section",
      "value": "A"
    },
    {
      "key": "seatId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "The process answers. No dependency checks.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Postgres and Redis reachable (1 s timeout each). 503 with `details` when not ready.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "201 `{ id, email, accessToken }`. Email is trimmed and lower-cased; password 8-128 chars. 409 `CONFLICT` if taken, 400 `VALIDATION_ERROR` with every invalid field.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new-user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.response.to.be.success);",
                  "const body = pm.response.json();",
                  "if (body.accessToken) {",
                  "  pm.collectionVariables.set('token', body.accessToken);",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "200 `{ id, email, accessToken }`. Saves `token` and `userId`. 401 `UNAUTHORIZED` with the same message for an unknown email and a wrong password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.response.to.be.success);",
                  "const body = pm.response.json();",
                  "if (body.accessToken) {",
                  "  pm.collectionVariables.set('token', body.accessToken);",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "200 `{ id, email }` of the token's user, read fresh from the database. 401 `UNAUTHORIZED` without a valid token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "204. Tokens are stateless: the client discards its token."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            },
            "description": "`[{ id, name, startsAt, onsaleAt, status, venue: { id, name } }]`. Public.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Event detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}"
              ]
            },
            "description": "Event plus `maxSeatsPerUser`, `waitingRoomEnabled`, `sections: [{ name, priceCents }]`. 404 `NOT_FOUND`.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Availability summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability"
              ]
            },
            "description": "`{ sections: [{ name, available, total }] }`. Expired holds count as available.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Seat map",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/seats?section={{section}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "seats"
              ],
              "query": [
                {
                  "key": "section",
                  "value": "{{section}}"
                }
              ]
            },
            "description": "`{ section, seats: [{ id, row, number, priceCents, status }] }`, status `available` or `unavailable` (never who holds it). 400 without `section`, 404 for an unknown section.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const free = pm.response.json().seats.find((s) => s.status === 'available');",
                  "if (free) pm.collectionVariables.set('seatId', free.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Holds",
      "item": [
        {
          "name": "Hold seats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "holds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [\n    {{seatId}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires login. Body `{ seatIds }` (1-6 distinct ids). All-or-nothing: either every seat is held or none. 201 `{ seats: [{ id, section, row, number, priceCents }], expiresAt }`. 409 `SEAT_UNAVAILABLE` with `details.seatIds` (the seats that could not be taken), 409 `HOLD_LIMIT_EXCEEDED` with `details { limit, owned, requested }` (held + bought seats per buyer per event), 409 `EVENT_NOT_ON_SALE`, 404 unknown event, 400 `VALIDATION_ERROR`. Repeated holds add seats and do not extend earlier ones. Seat map saves the first available seat as `seatId`."
          }
        }
      ]
    },
    {
      "name": "Dev",
      "item": [
        {
          "name": "Reset event",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dev/events/{{eventId}}/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dev",
                "events",
                "{{eventId}}",
                "reset"
              ]
            },
            "description": "Only with `ENABLE_DEV_ROUTES=true` (on in Docker Compose). Removes orders, payments and tickets of the event and makes every seat available. Otherwise answers like an unknown route (404).",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
