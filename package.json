{
  "name": "modex",
  "version": "1.0.0",
  "description": "High-concurrency concert ticket booking service built on Modex, a lightweight Express 5 + TypeScript framework",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/main.ts",
    "dev:payments": "ts-node-dev --respawn src/payments-provider/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "db:reset": "ts-node src/database/seed.ts reset",
    "test": "jest --runInBand",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration --runInBand",
    "load": "bash load/run.sh"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
