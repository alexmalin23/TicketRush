NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/modex
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# Use a long random string in real environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# "*" or a comma separated list, e.g. http://localhost:5173,http://localhost:8081
CORS_ORIGIN=*
LOG_LEVEL=info

# Used by `npm test` only. Tests TRUNCATE tables, never point this at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/modex_test

# Redis connection URL
REDIS_URL=redis://localhost:6379
# Used by `npm test` only (logical DB 1, tests may flush it).
TEST_REDIS_URL=redis://localhost:6379/1

# Exposes /api/v1/dev/* (event reset between load runs). Never enable in production.
ENABLE_DEV_ROUTES=false
