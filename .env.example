NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/modex
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
# replica sends reads that tolerate lag to DATABASE_REPLICA_URL. The Compose replica
# (--profile replica) is reachable from the containerized stack only.
READ_ROUTING=primary
DATABASE_REPLICA_URL=

# Use a long random string in real environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# "*" or a comma separated list, e.g. http://localhost:5173,http://localhost:8081
CORS_ORIGIN=*
LOG_LEVEL=info
# "text" (readable) or "json" (one object per line, used in containers)
LOG_FORMAT=text

# Used by `npm test` only. Tests TRUNCATE tables, never point this at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/modex_test

# Redis connection URL
REDIS_URL=redis://localhost:6379
# Used by `npm test` only (logical DB 1, tests may flush it).
TEST_REDIS_URL=redis://localhost:6379/1

# Serve read paths from Redis (false = every read goes to Postgres)
CACHE_ENABLED=true
EVENT_CACHE_TTL_SECONDS=300
AVAILABILITY_CACHE_TTL_MS=1000
AVAILABILITY_STALE_MS=1000

# sync charges inside the request (no worker needed); async answers 202 and needs `npm run worker`.
ORDER_PROCESSING=sync
WORKER_CONCURRENCY=20
WAITING_ROOM_ENABLED=false
WAITING_ROOM_ADMIT_PER_SECOND=50
ACCESS_TOKEN_TTL_SECONDS=600

# Exposes /api/v1/dev/* (event reset between load runs). Never enable in production.
ENABLE_DEV_ROUTES=false

HOLD_TTL_SECONDS=600
# Hold attempts per buyer per window before 429 (counted per API instance)
HOLD_RATE_LIMIT=5
HOLD_RATE_WINDOW_SECONDS=10

# Payments: the API calls the provider; the provider simulates latency, declines and timeouts
PAYMENTS_PROVIDER_URL=http://localhost:3100
PAYMENT_TIMEOUT_MS=3000
# Each replica looks for orders a crash or a timeout left pending_payment (0 = off)
RECONCILE_INTERVAL_SECONDS=5
RECONCILE_AFTER_SECONDS=30
PAYMENTS_PROVIDER_PORT=3100
MOCK_PAYMENT_LATENCY_MS_MIN=300
MOCK_PAYMENT_LATENCY_MS_MAX=1500
MOCK_PAYMENT_FAILURE_RATE=0.1
MOCK_PAYMENT_TIMEOUT_RATE=0.02
MOCK_PAYMENT_HANG_MS=30000
